# Optional: point the app at your own PeerJS signaling server instead of the
# free public one (0.peerjs.com). Set these in Vercel → Project → Settings →
# Environment Variables.
# VITE_PEER_HOST=peer.example.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=true
# Optional JSON array of ICE servers (add a TURN server for players behind strict NATs)
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
