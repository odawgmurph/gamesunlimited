# Optional: point the app at your own PeerJS signaling server instead of the
# free public one (0.peerjs.com). Set these in Vercel → Project → Settings →
# Environment Variables.
# VITE_PEER_HOST=peer.example.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=true
# TURN relay, needed for most cross-network play (see README → Networking).
# Server-side only (read by api/ice.js, never shipped to the browser bundle):
# CLOUDFLARE_TURN_KEY_ID=...
# CLOUDFLARE_TURN_API_TOKEN=...
# or any provider's servers as a JSON array:
# ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
# Optional extra ICE servers baked into the client build:
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
